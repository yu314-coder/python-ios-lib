+ * `.selected_editable_objects` / `.visible_objects` / `.objects` work the same as
+ * in a GUI session. There is no View3D here, so the BASE_* macros fall back to
+ * the view-layer visibility flags. */
+static eContextResult ctx_data_view_layer_object_fallback(const bContext *C,
+                                                          const char *member,
+                                                          bContextDataResult *result)
+{
+  Scene *scene = CTX_data_scene(C);
+  if (scene == nullptr) {
+    return CTX_RESULT_MEMBER_NOT_FOUND;
+  }
+  ViewLayer *view_layer = CTX_data_view_layer(C);
+  if (view_layer == nullptr) {
+    return CTX_RESULT_MEMBER_NOT_FOUND;
+  }
+  const Main *bmain = CTX_data_main(C);
