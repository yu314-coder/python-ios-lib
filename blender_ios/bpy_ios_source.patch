+  const bool want_selected_editable = STREQ(member, "selected_editable_objects");
+  const bool want_visible = STREQ(member, "visible_objects");
+  const bool want_all = STREQ(member, "objects");
+  if (want_selected || want_selected_editable || want_visible || want_all) {
+    for (Base &base : *BKE_view_layer_object_bases_get(view_layer)) {
+      bool add = want_all;
+      if (want_selected) {
+        add = BASE_SELECTED(nullptr, &base);
+      }
+      else if (want_selected_editable) {
+        add = BASE_SELECTED_EDITABLE(nullptr, &base);
+      }
+      else if (want_visible) {
+        add = BASE_VISIBLE(nullptr, &base);
+      }
