+    /* Called once for every frame sent, whether it was encoded, dropped or
+     * failed: one frame less being encoded (see max_pending). */
+    pthread_mutex_lock(&vtctx->lock);
+    vtctx->frames_done++;
+    pthread_cond_broadcast(&vtctx->cv_sample_sent);
