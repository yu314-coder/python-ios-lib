@@ -2483,6 +2499,26 @@
     if (!node)
         return AVERROR(ENOMEM);
 
+    /* VideoToolbox takes frames as fast as they come and holds each one
+     * (a copy of the whole picture) until it is encoded, so a sender
+     * quicker than the hardware leaves it holding a queue of them for no
+     * speed. With max_pending, wait until fewer than that many are being
+     * encoded. Not with frame reordering, which holds frames back until
+     * later ones arrive; and never for more than 2 s at a time. */
+    if (vtctx->max_pending > 0 && !vtctx->has_b_frames) {
+        struct timespec until;
+        clock_gettime(CLOCK_REALTIME, &until);
+        until.tv_sec += 2;
+        pthread_mutex_lock(&vtctx->lock);
+        while (vtctx->frames_sent - vtctx->frames_done >= vtctx->max_pending &&
+               !vtctx->async_error) {
+            if (pthread_cond_timedwait(&vtctx->cv_sample_sent, &vtctx->lock,
+                                       &until) == ETIMEDOUT)
+                break;
+        }
+        pthread_mutex_unlock(&vtctx->lock);
+    }
+
     status = create_cv_pixel_buffer(avctx, frame, &cv_img, node);
     if (status)
