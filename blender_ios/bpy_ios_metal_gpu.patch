diff --git a/source/blender/gpu/metal/mtl_ios_compat.hh b/source/blender/gpu/metal/mtl_ios_compat.hh
new file mode 100644
--- /dev/null
+++ b/source/blender/gpu/metal/mtl_ios_compat.hh
@@ -0,0 +1,76 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * iOS Metal compatibility shims.
+ *
+ * iOS GPUs are always unified-memory (Apple silicon): there is no "managed"
+ * storage mode, and the managed-storage CPU<->GPU coherency calls that macOS
+ * needs -- `-[MTLBlitCommandEncoder synchronizeResource:]` and
+ * `-[MTLBuffer didModifyRange:]` -- are `API_UNAVAILABLE(ios)` in the SDK, so
+ * referencing them is a hard compile error even in dead code.
+ *
+ * This header:
+ *   1. Maps the managed storage enums onto their shared equivalents *after*
+ *      `<Metal/Metal.h>` has fully declared the real enum (so the SDK's own
+ *      declaration is untouched, and every subsequent Blender reference to
+ *      `...Managed` resolves to `...Shared`). Because
+ *      `MTLResourceStorageModeShared == 0`, the common test
+ *      `options & MTLResourceStorageModeManaged` becomes `& 0` -> always false,
+ *      which is exactly right: no iOS buffer is ever managed.
+ *   2. Provides no-op inline wrappers for the coherency calls, so the ~20
+ *      call sites compile for iphoneos (shared storage is coherent with no
+ *      explicit flush).
+ *
+ * Include this FIRST in every Metal `.mm` that touches those APIs; it pulls in
+ * `<Metal/Metal.h>` itself, guaranteeing the include-order requirement above.
+ * On macOS / Mac Catalyst this header is a transparent pass-through.
+ */
+
+#pragma once
+
+#include <Metal/Metal.h>
+#include <TargetConditionals.h>
+
+/* "Real" iOS: device or simulator, but NOT Mac Catalyst (which is macOS ABI and
+ * keeps the managed-storage APIs). */
+#if defined(TARGET_OS_IOS) && TARGET_OS_IOS && !(defined(TARGET_OS_MACCATALYST) && TARGET_OS_MACCATALYST)
+#  define GHOST_MTL_IOS_UNIFIED 1
+#else
+#  define GHOST_MTL_IOS_UNIFIED 0
+#endif
+
+#if GHOST_MTL_IOS_UNIFIED
+/* Remap managed -> shared for all Blender usage below this include. Safe: the
+ * SDK enum is already declared by <Metal/Metal.h> above. */
+#  define MTLStorageModeManaged MTLStorageModeShared
+#  define MTLResourceStorageModeManaged MTLResourceStorageModeShared
+#endif
+
+/* CPU-modified-a-managed-buffer notification. No-op on iOS (shared storage is
+ * automatically coherent; the GPU sees CPU writes without a flush). */
+static inline void mtl_buffer_did_modify_range(id<MTLBuffer> buffer, NSRange range)
+{
+#if GHOST_MTL_IOS_UNIFIED
+  (void)buffer;
+  (void)range;
+#else
+  [buffer didModifyRange:range];
+#endif
+}
+
+/* Flush a managed resource from GPU caches back to CPU-visible memory. No-op on
+ * iOS (shared storage needs no synchronize). */
+static inline void mtl_blit_synchronize_resource(id<MTLBlitCommandEncoder> encoder,
+                                                  id<MTLResource> resource)
+{
+#if GHOST_MTL_IOS_UNIFIED
+  (void)encoder;
+  (void)resource;
+#else
+  [encoder synchronizeResource:resource];
+#endif
+}
