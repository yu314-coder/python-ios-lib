# iOS arm64 source patches for the Blender (bpy) headless Python module.
# Base: upstream Blender commit c9dd766c.  Apply from the Blender source root:
#   git apply bpy_ios_source.patch   (or:  patch -p1 < bpy_ios_source.patch)
#
# context.cc      - headless bpy context: resolve active_object/object/
#                   selected_objects/visible_objects from the active view layer
#                   when there is no screen/editor context (desktop scripts run
#                   unmodified); relax the WITH_PYTHON_MODULE main-thread guard
#                   so bpy.context.* works on a worker thread.
# movie_util.cc   - MOV_thread_count() -> 1 on iOS (FFmpeg encoder thread
#                   teardown crashes with >1).
# movie_write.cc  - skip the hardware pixel format AV_PIX_FMT_VIDEOTOOLBOX, pick
#                   the first software format, so h264/hevc_videotoolbox encode.
# usd_precomp.hh  - gate the Hydra (imaging) includes on WITH_HYDRA; the iOS USD
#                   build has no GL Hydra render delegate, but the non-Hydra USD
#                   I/O still needs to compile.
# usd_hook.cc     - stub the USD <-> Python hook bridge: iOS OpenUSD is built
#                   without its Python bindings (pxr/external/boost/python), so
#                   USD import/export work while script-registered USDHook
#                   callbacks no-op. Stubs BOTH the internal converters AND the
#                   public registration API (USD_register_hook / _unregister_hook
#                   / _find_hook_name) that the USDHook RNA type links against --
#                   omitting the latter makes `import bpy` fail at runtime with an
#                   undefined USD_register_hook symbol. (Original kept as
#                   usd_hook.cc.ios-orig.)
# messages_apple.mm - Cocoa -> Foundation (NSLocale lives in Foundation; iOS has
#                   no Cocoa/AppKit, and the body is #if'd out under WITH_HEADLESS).
# fluidsolver.cpp - mantaflow (WITH_MOD_FLUID): GridStorage::free() errMsg ->
#                   debMsg. Freeing a fluid DOMAIN whose grids are still in use
#                   threw an uncaught Manta exception on a worker thread ->
#                   std::terminate (via llama.cpp's ggml handler) -> the app
#                   aborted. The grids are freed regardless, so downgrade to a
#                   non-throwing debug message. (extern/, preprocessed generated
#                   file -- checked in, not regenerated by the iOS build.)
# macros.cmake    - msgfmt_simple(): when HOST_MSGFMT is set (iOS cross-compile,
#                   see configure_blender.sh), build .po->.mo with that host tool
#                   and depend on the file, NOT the cross `msgfmt` target. The
#                   cross msgfmt is an iphoneos binary that SIGKILLs if run on the
#                   host; depending on the target also relinks it over the shim on
#                   incremental builds. Native builds keep using the target.
# msgfmt/CMakeLists.txt - EXCLUDE_FROM_ALL the msgfmt executable when HOST_MSGFMT
#                   is set, so ninja never links the un-runnable iOS binary at all.
# platform_apple_ios.cmake - the iOS platform file (port-added; absent upstream so
#                   emitted here as a NEW file). Adds: WITH_CODEC_SNDFILE minimal
#                   libsndfile handling (MODULE-mode find + skip NOTFOUND FLAC/Ogg/
#                   Vorbis so they don't poison audaspace's link); and appends the
#                   rebuilt libtiff to OpenImageIO::OpenImageIO's interface link
#                   (OIIO's TIFF plugin references libtiff, which its exported
#                   config does not carry -> otherwise bpy dlopen fails with
#                   undefined _TIFFClientOpen &c).
