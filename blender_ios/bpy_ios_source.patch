+if(WITH_VULKAN_BACKEND)
+  find_package(ShaderC REQUIRED)
+  find_package(Vulkan REQUIRED)
+endif()
+
+if(WITH_SDL)
+  find_package(SDL3 REQUIRED CONFIG)
+endif()
+add_bundled_libraries(sdl/lib)
+
+if(NOT WITH_HEADLESS)
+  set(EPOXY_ROOT_DIR ${LIBDIR}/epoxy)
+  find_package(Epoxy REQUIRED)
+endif()
+
+set(PNG_ROOT ${LIBDIR}/png)
+find_package(PNG REQUIRED)
+
+set(JPEG_ROOT ${LIBDIR}/jpeg)
+find_package(JPEG REQUIRED)
+
+set(fmt_ROOT ${LIBDIR}/fmt)
+find_package(fmt REQUIRED)
+
+if(WITH_IMAGE_WEBP)
+  set(WEBP_ROOT_DIR ${LIBDIR}/webp)
+  find_package(WebP REQUIRED)
+endif()
+
+if(WITH_CODEC_FFMPEG)
+  string(APPEND PLATFORM_LINKFLAGS " -liconv") # ffmpeg needs it !
+endif()
+
+if(WITH_PUGIXML)
+  find_package(PugiXML REQUIRED)
+endif()
+
+find_package(OpenImageIO REQUIRED)
+# The iOS OpenImageIO is rebuilt with the TIFF plugin, but its exported CMake
+# config does NOT carry libtiff as an interface dependency -> without this the
+# bpy module dlopen fails with "symbol not found: _TIFFClientOpen" (and 36 other
+# TIFF* symbols). Append libtiff to the imported target so every consumer links
+# it. libtiff's own deps (libdeflate/webp/jpeg/zstd/zlib) are already linked, and
+# it is rebuilt without the LZMA codec (build_tiff_ios.sh) so it needs no liblzma.
+find_library(_oiio_tiff_LIBRARY NAMES tiff HINTS ${LIBDIR}/lib ${LIBDIR}/tiff/lib)
+if(_oiio_tiff_LIBRARY AND TARGET OpenImageIO::OpenImageIO)
+  set_property(TARGET OpenImageIO::OpenImageIO
+    APPEND PROPERTY INTERFACE_LINK_LIBRARIES ${_oiio_tiff_LIBRARY})
+endif()
+add_bundled_libraries(openimageio/lib)
+
+find_package(OpenColorIO 2.0.0 REQUIRED CONFIG)
+add_bundled_libraries(opencolorio/lib)
+
+if(WITH_OPENVDB)
+  find_package(OpenVDB)
+  find_library(BLOSC_LIBRARIES NAMES blosc HINTS ${LIBDIR}/openvdb/lib)
+  if(BLOSC_LIBRARIES)
+    list(APPEND OPENVDB_LIBRARIES ${BLOSC_LIBRARIES})
+  else()
+    unset(BLOSC_LIBRARIES CACHE)
+  endif()
+  if(OPENVDB_FOUND)
+    set(OPENVDB_DEFINITIONS "")
+  endif()
+endif()
+add_bundled_libraries(openvdb/lib)
+
+if(WITH_NANOVDB)
+  find_package(NanoVDB)
+endif()
+
+test_neon_support()
+if(SUPPORTS_NEON_BUILD)
+  find_package(sse2neon REQUIRED)
+endif()
