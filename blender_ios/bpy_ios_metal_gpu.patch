 #include "BKE_global.hh"
 
@@ -226,6 +228,17 @@
     if (use_texture_atomic) {
       options.languageVersion = MTLLanguageVersion3_1;
     }
+  }
+#endif
+#if TARGET_OS_IOS
+  /* iOS 16.4+ always supports Metal 3, so raise the baseline to MSL 3.0 (3.1 on
+   * iOS 17+). This declares the SIMD-group reduction intrinsics (simd_or /
+   * simd_min / simd_max, used by EEVEE's light iterator under GPU_METAL) and
+   * texture atomics -- the macOS-gated 3.1 path above is compiled out on iOS,
+   * which otherwise left iOS shaders stuck at 2.2 and failed to compile EEVEE. */
+  options.languageVersion = MTLLanguageVersion3_0;
+  if (@available(iOS 17.0, *)) {
+    options.languageVersion = MTLLanguageVersion3_1;
   }
 #endif
   return options;
